[user]
    name = {{ .identity.name }}
    email = {{ .identity.email }}

{{ if not (dig "headless" false .) -}}
[credential]
    credentialStore = secretservice

{{ end -}}

[credential "https://dev.azure.com"]
    useHttpPath = true

[push]
    autoSetupRemote = true
[init]
        defaultBranch = main

[alias]
	commit-gen = !git-commit-gen
	cg = "!f() { MSG=$(git-commit-gen) && git commit -F - <<< \"$MSG\"; }; f"
[url "git@github.com:"]
	insteadof = https://github.com/

{{ range (dig "git_identity_overrides" (list) .) -}}
[includeIf "{{ .condition }}"]
	path = ~/.gitconfig-{{ .identity }}
{{ end -}}

[include]
	path = ~/.gitconfig-local
