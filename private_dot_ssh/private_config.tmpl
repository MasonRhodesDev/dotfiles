{{ if dig "headless" false . -}}
Host *
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes
    ServerAliveInterval 60
    ServerAliveCountMax 3
{{ else if eq .system.hostname "mason-desktop" -}}
Host desk-controller desk-controller.lan desk-controller.local
    ConnectTimeout 10
    ServerAliveInterval 60
    ServerAliveCountMax 3

Host unraid-games
    HostName 192.168.1.7
    User games
    IdentityFile ~/.ssh/games
    IdentitiesOnly yes
    ConnectTimeout 10
    ServerAliveInterval 60
    ServerAliveCountMax 3

Host *
    AddKeysToAgent yes
    IdentityFile ~/.ssh/id_ed25519
{{ else -}}
{{ if eq .system.hostname "mason-air" -}}
Match host dev exec "tailscale status --json 2>/dev/null | grep -q '\"BackendState\": \"Running\"'"
    HostName 100.77.209.8

Host dev
    HostName 192.168.1.22
    User mason
    ConnectTimeout 10
    ServerAliveInterval 60
    ServerAliveCountMax 3

{{ end -}}
Host i-* mi-*
    ProxyCommand /home/mason/bin/ssm-proxy %h %p
    StrictHostKeyChecking no
    UserKnownHostsFile /dev/null
{{ end -}}
