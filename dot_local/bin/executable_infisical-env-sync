#!/usr/bin/env python3
"""Keep ~/.config/infisical/env.sh in sync with an Infisical project.

Reads machine-identity credentials from ~/.config/infisical/machine.env, polls
Infisical every INFISICAL_SYNC_INTERVAL seconds (default 10), and atomically
rewrites env.sh only when the secrets change. Shells pick it up via
~/.bashrc.d (prompt hook + BASH_ENV). Runs as infisical-env-sync.service.
"""
import json
import os
import re
import shlex
import subprocess
import sys
import time

CONF_DIR = os.path.expanduser("~/.config/infisical")
MACHINE_ENV = os.path.join(CONF_DIR, "machine.env")
OUT = os.path.join(CONF_DIR, "env.sh")

# Never let a synced secret clobber variables the shell itself depends on.
DENY = {"PATH", "HOME", "USER", "SHELL", "BASH_ENV", "ENV", "IFS", "PS1", "PS2",
        "PROMPT_COMMAND", "LD_PRELOAD", "LD_LIBRARY_PATH", "PWD", "OLDPWD"}
VALID_KEY = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")


def log(msg):
    print(msg, file=sys.stderr, flush=True)


def load_machine_env():
    conf = {}
    with open(MACHINE_ENV) as f:
        for line in f:
            line = line.strip()
            if line and not line.startswith("#") and "=" in line:
                k, v = line.split("=", 1)
                conf[k.strip()] = v.strip().strip("'\"")
    return conf


def login(conf):
    return subprocess.run(
        ["infisical", "login", "--method=universal-auth",
         "--client-id", conf["INFISICAL_CLIENT_ID"],
         "--client-secret", conf["INFISICAL_CLIENT_SECRET"],
         "--silent", "--plain"],
        check=True, capture_output=True, text=True).stdout.strip()


def fetch(conf, token):
    out = subprocess.run(
        ["infisical", "export", "--format=json", "--silent",
         "--projectId", conf["INFISICAL_PROJECT_ID"],
         "--env", conf.get("INFISICAL_ENV", "dev"),
         "--path", conf.get("INFISICAL_PATH", "/")],
        check=True, capture_output=True, text=True,
        env={**os.environ, "INFISICAL_TOKEN": token}).stdout
    secrets = {}
    for item in json.loads(out or "[]"):
        k = item.get("key", item.get("secretKey"))
        v = item.get("value", item.get("secretValue", ""))
        if not k or not VALID_KEY.match(k) or k in DENY:
            log(f"skipping unsafe key: {k!r}")
            continue
        secrets[k] = v
    return secrets


def render(secrets):
    lines = ["# Generated by infisical-env-sync. Do not edit; changes are overwritten."]
    lines += [f"export {k}={shlex.quote(v)}" for k, v in sorted(secrets.items())]
    lines.append(f"__INFISICAL_KEYS={shlex.quote(' '.join(sorted(secrets)))}")
    return "\n".join(lines) + "\n"


def write_if_changed(content):
    try:
        with open(OUT) as f:
            if f.read() == content:
                return False
    except FileNotFoundError:
        pass
    tmp = OUT + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(content)
    os.replace(tmp, OUT)
    return True


def main():
    interval = int(os.environ.get("INFISICAL_SYNC_INTERVAL", "10"))
    token = None
    while True:
        try:
            conf = load_machine_env()
            if token is None:
                token = login(conf)
                log("logged in")
            try:
                secrets = fetch(conf, token)
            except subprocess.CalledProcessError:
                # Token likely expired; log in again once before giving up this round.
                token = login(conf)
                secrets = fetch(conf, token)
            if write_if_changed(render(secrets)):
                log(f"env.sh updated ({len(secrets)} keys)")
        except subprocess.CalledProcessError as e:
            token = None
            msgs = [l.strip() for l in (e.stderr or "").splitlines() if "Message:" in l]
            log(f"sync failed, keeping previous env.sh: {msgs[0] if msgs else (e.stderr or '').strip()[-300:]}")
        except Exception as e:  # keep the daemon alive; systemd logs the reason
            token = None
            log(f"sync failed, keeping previous env.sh: {e}")
        time.sleep(interval)


if __name__ == "__main__":
    main()
