#!/usr/bin/env python3
"""bt-stale-bond-guard — drop BlueZ bonds that the peer no longer has.

Symptom this fixes: a bonded LE device (Xbox controller, BLE mouse, ...) whose
side of the bond was wiped (pair button held, paired to another host) keeps
reconnecting every ~2s. bluetoothd starts encryption with the stale LTK, the
peer answers "PIN or Key Missing", bluetoothd disconnects, repeat forever —
spamming `hog-lib.c ... unlikely error` in the journal and confusing Steam.
JustWorksRepairing doesn't help because the peer never sends a pairing request.

Heuristic: a Paired device that flaps Connected true→false N times within a
window, each time without ServicesResolved becoming true, has a stale bond.
We call Adapter1.RemoveDevice(), remember the address, and keep discovery on
for a while: when the same address advertises again (user pressed its sync
button) we Pair + Trust + Connect it — no menus.
"""
import os
import subprocess
import sys
import time

import gi

gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib  # noqa: E402

FLAPS = int(os.environ.get("BT_GUARD_FLAPS", "5"))          # short cycles needed
WINDOW = float(os.environ.get("BT_GUARD_WINDOW", "30"))     # seconds
MAX_UP = float(os.environ.get("BT_GUARD_MAX_UP", "3"))      # a "real" connection lives longer
REPAIR_FOR = float(os.environ.get("BT_GUARD_REPAIR_FOR", "600"))  # seconds to wait for sync button

BLUEZ = "org.bluez"
DEV = "org.bluez.Device1"
ADAPTER = "org.bluez.Adapter1"

bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
state = {}  # path -> {"up": ts|None, "resolved": bool, "flaps": [ts,...]}
pending = {}  # address -> {"name": str, "adapter": path, "until": ts, "busy": bool}


def log(msg):
    print(msg, flush=True)


def get_prop(path, prop):
    try:
        r = bus.call_sync(BLUEZ, path, "org.freedesktop.DBus.Properties", "Get",
                          GLib.Variant("(ss)", (DEV, prop)), None,
                          Gio.DBusCallFlags.NONE, 2000, None)
        return r.unpack()[0]
    except GLib.Error:
        return None


def notify(title, body):
    try:
        subprocess.Popen(["notify-send", "-a", "Bluetooth", "-i", "bluetooth", title, body])
    except OSError:
        pass


def call(path, iface, method, args=None, timeout=30000):
    bus.call_sync(BLUEZ, path, iface, method, args, None,
                  Gio.DBusCallFlags.NONE, timeout, None)


def set_discovery(adapter, on):
    try:
        call(adapter, ADAPTER, "StartDiscovery" if on else "StopDiscovery", timeout=5000)
    except GLib.Error as e:
        if "InProgress" not in str(e) and "NotReady" not in str(e):
            log(f"discovery {'on' if on else 'off'} failed: {e}")


def remove_device(path):
    name = get_prop(path, "Name") or "?"
    addr = get_prop(path, "Address") or path.rsplit("/", 1)[-1]
    adapter = get_prop(path, "Adapter")
    try:
        call(adapter, ADAPTER, "RemoveDevice", GLib.Variant("(o)", (path,)), timeout=5000)
        log(f"removed stale bond: {name} ({addr}) — peer rejected our key {FLAPS}x in {WINDOW:.0f}s")
        notify(f"Removed stale pairing: {name}",
               f"{addr} kept rejecting the stored key. Press its sync button to re-pair automatically.")
        pending[addr] = {"name": name, "adapter": adapter,
                         "until": time.monotonic() + REPAIR_FOR, "busy": False}
        set_discovery(adapter, True)
        GLib.timeout_add_seconds(int(REPAIR_FOR) + 1, expire_pending, addr)
    except GLib.Error as e:
        log(f"RemoveDevice failed for {name} ({addr}): {e}")
    state.pop(path, None)


def expire_pending(addr):
    p = pending.get(addr)
    if p and time.monotonic() >= p["until"] and not p["busy"]:
        pending.pop(addr, None)
        log(f"gave up waiting for {p['name']} ({addr}) to re-appear")
        if not pending:
            set_discovery(p["adapter"], False)
    return False


def repair(path, addr):
    p = pending[addr]
    p["busy"] = True
    log(f"{p['name']} ({addr}) is advertising again — pairing")
    try:
        call(path, DEV, "Pair", timeout=60000)
        bus.call_sync(BLUEZ, path, "org.freedesktop.DBus.Properties", "Set",
                      GLib.Variant("(ssv)", (DEV, "Trusted", GLib.Variant("b", True))),
                      None, Gio.DBusCallFlags.NONE, 5000, None)
        try:
            call(path, DEV, "Connect", timeout=30000)
        except GLib.Error as e:
            if "AlreadyConnected" not in str(e):
                log(f"connect after pair: {e}")
        log(f"re-paired {p['name']} ({addr})")
        notify(f"Re-paired: {p['name']}", f"{addr} is connected.")
        pending.pop(addr, None)
        if not pending:
            set_discovery(p["adapter"], False)
    except GLib.Error as e:
        log(f"pair failed for {p['name']} ({addr}): {e} — will retry if it advertises again")
        p["busy"] = False
    return False


def on_ifaces_added(conn, sender, path, iface, signal, params):
    obj, ifaces = params.unpack()
    dev = ifaces.get(DEV)
    if not dev:
        return
    addr = dev.get("Address")
    if addr in pending and not pending[addr]["busy"]:
        GLib.idle_add(repair, obj, addr)


def on_props(conn, sender, path, iface, signal, params):
    interface, changed, _inv = params.unpack()
    if interface != DEV:
        return
    st = state.setdefault(path, {"up": None, "resolved": False, "flaps": []})
    now = time.monotonic()
    if changed.get("ServicesResolved"):
        st["resolved"] = True
    if "Connected" not in changed:
        return
    if changed["Connected"]:
        st["up"], st["resolved"] = now, False
        return
    # disconnected
    up = st["up"]
    st["up"] = None
    if up is None or st["resolved"] or now - up > MAX_UP:
        st["flaps"].clear()
        return
    st["flaps"] = [t for t in st["flaps"] if now - t < WINDOW] + [now]
    if len(st["flaps"]) < FLAPS:
        return
    if not get_prop(path, "Paired"):
        st["flaps"].clear()
        return
    remove_device(path)


bus.signal_subscribe(BLUEZ, "org.freedesktop.DBus.Properties", "PropertiesChanged",
                     None, None, Gio.DBusSignalFlags.NONE, on_props)
bus.signal_subscribe(BLUEZ, "org.freedesktop.DBus.ObjectManager", "InterfacesAdded",
                     "/", None, Gio.DBusSignalFlags.NONE, on_ifaces_added)
log(f"watching for stale bonds (>{FLAPS} short connects within {WINDOW:.0f}s)")
try:
    GLib.MainLoop().run()
except KeyboardInterrupt:
    sys.exit(0)
