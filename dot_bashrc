# .bashrc

# Source global definitions
if [ -f /etc/bashrc ]; then
    . /etc/bashrc
fi

# ble.sh — line editor (autosuggestions, syntax highlighting, vi mode).
# --noattach: the rest of this file still runs in plain readline context;
# the ble-attach at the very end of this file picks up every hook/binding
# registered in between (oh-my-posh, atuin, zoxide, fzf, direnv).
if [[ $- == *i* && -f ~/.local/share/blesh/ble.sh ]]; then
    source ~/.local/share/blesh/ble.sh --noattach
fi

# PATH helpers, loaded before anything here manipulates PATH. The ~/.bashrc.d
# loop below re-sources this file, which is harmless — it only defines
# functions. Every PATH mutation from here on goes through these.
if [ -f ~/.bashrc.d/00-path-helpers.bashrc ]; then
    . ~/.bashrc.d/00-path-helpers.bashrc
fi

# User specific environment (prepended in reverse, so ~/.local/bin ends up first)
path_prepend "$HOME/bin"
path_prepend "$HOME/.local/bin"

# Uncomment the following line if you don't like systemctl's auto-paging feature:
# export SYSTEMD_PAGER=

# User specific aliases and functions
if [ -d ~/.bashrc.d ]; then
    for rc in ~/.bashrc.d/*; do
        if [ -f "$rc" ]; then
            . "$rc"
        fi
    done
fi
unset rc
# Test change

# Load user env script if present
if [ -f "$HOME/.local/bin/env" ]; then
    . "$HOME/.local/bin/env"
fi

# TARS - ClickUp Configuration (from Secret Service)
export CLICKUP_API_TOKEN=$(secret-tool lookup application tars service clickup type token 2>/dev/null || echo "")
export CLICKUP_TEAM_ID=$(secret-tool lookup application tars service clickup type teamid 2>/dev/null || echo "")

# direnv hook for automatic nix-shell loading
eval "$(direnv hook bash)"
export LD_LIBRARY_PATH="$HOME/.local/lib:$LD_LIBRARY_PATH"

# Normalize PATH last. Everything above this line may prepend to PATH —
# including ~/.local/bin/env, which runs after the ~/.bashrc.d loop — so this
# is the only point that sees the final value. Defined in
# ~/.bashrc.d/00-path-helpers.bashrc; guarded so a missing ~/.bashrc.d cannot
# break shell startup.
declare -F path_dedupe >/dev/null && path_dedupe

# ble.sh attach — must stay the LAST line of this file.
[[ ${BLE_VERSION-} ]] && ble-attach
