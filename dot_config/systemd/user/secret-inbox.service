[Unit]
Description=Secret inbox: phone form that writes requested secrets to Infisical
# Only on machines given a write-capable inbox identity.
ConditionPathExists=%h/.config/infisical/inbox.env
ConditionPathExists=%h/.config/infisical/machine.env

[Service]
ExecStart=/usr/bin/python3 %h/.local/bin/secret-inbox
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
