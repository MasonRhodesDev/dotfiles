[Unit]
Description=Herdr — persistent terminal workspace server for AI coding agents
# Started with the graphical session so panes inherit a live Wayland/DBus env
# (clipboard, notifications, xdg-open). Deliberately NOT PartOf that target:
# the whole point of the server is to outlive compositor restarts and client
# detach, so a Hyprland restart must not take the agent panes down with it.
After=graphical-session.target
# A second `herdr server` on a live socket exits 1 ("already running"). Cap the
# retries so a socket conflict can't crash-loop the way cylon-orchestrator did.
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
ExecStart=%h/.local/bin/herdr server
# Graceful shutdown via the API socket so session.json is flushed before the
# cgroup is torn down (pane children die with the server either way).
ExecStop=%h/.local/bin/herdr server stop
Restart=on-failure
RestartSec=5
Environment=PATH=%h/.local/bin:%h/.npm-global/bin:/usr/local/bin:/usr/bin:/bin
# Agent hooks shell out to secret-tool/notify-send; user units don't export this
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=%t/bus

[Install]
WantedBy=graphical-session.target
