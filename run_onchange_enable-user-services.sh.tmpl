#!/bin/bash
# Managed by chezmoi — re-runs when any tracked service file changes.
# DE services (hypridle, swaync, waybar, swaybg, udiskie, …) are enabled by
# the hypr-de package's user preset + hypr-de-setup, not here.
#
# Service checksums (do not edit — used to detect changes):
# api-keys:              {{ include "dot_config/systemd/user/api-keys.service" | sha256sum }}
# browser-guard.path:    {{ include "dot_config/systemd/user/browser-default-guard.path" | sha256sum }}
# browser-guard.service: {{ include "dot_config/systemd/user/browser-default-guard.service" | sha256sum }}
# browser-guard.bin:     {{ include "dot_local/bin/executable_browser-default-guard" | sha256sum }}
# hypridle knobs:        {{ include "dot_config/hypr-de/hypridle.conf.tmpl" | sha256sum }}
# keyring-resync:        {{ include "dot_config/systemd/user/keyring-resync.service" | sha256sum }}
# keyring-resync.bin:    {{ include "dot_local/bin/executable_keyring-resync" | sha256sum }}
# infisical-env-sync:    {{ include "dot_config/systemd/user/infisical-env-sync.service" | sha256sum }}
# infisical-env-sync.bin: {{ include "dot_local/bin/executable_infisical-env-sync" | sha256sum }}
# secret-inbox:          {{ include "dot_config/systemd/user/secret-inbox.service" | sha256sum }}
# secret-inbox.bin:      {{ include "dot_local/bin/executable_secret-inbox" | sha256sum }}

set -euo pipefail

systemctl --user daemon-reload

echo "→ api-keys"
systemctl --user enable api-keys 2>/dev/null || true
systemctl --user restart api-keys || true

# Path-triggered guard that reasserts Chromium as the default browser whenever
# Slack hijacks mimeapps.list. Enable/start the .path (not the .service — the
# oneshot service is launched by the path unit on demand).
echo "→ browser-default-guard.path"
systemctl --user enable browser-default-guard.path 2>/dev/null || true
systemctl --user restart browser-default-guard.path || true

# Re-keys the login keyring to the login password when PAM could not unlock it
# (login password changed). Runs at graphical login, exits silently otherwise.
echo "→ keyring-resync"
systemctl --user enable keyring-resync.service 2>/dev/null || true

# Syncs Infisical secrets to ~/.config/infisical/env.sh. The unit is skipped
# (ConditionPathExists) on hosts without ~/.config/infisical/machine.env.
echo "→ infisical-env-sync"
systemctl --user enable infisical-env-sync.service 2>/dev/null || true
systemctl --user try-restart infisical-env-sync.service || true

# Phone form that writes requested secrets to Infisical (needs ~/.config/infisical/inbox.env).
echo "→ secret-inbox"
systemctl --user enable secret-inbox.service 2>/dev/null || true
systemctl --user try-restart secret-inbox.service || true

# Hosts with a hypr-DE idle knob file (mason-air): restart hypridle so the
# launcher re-splices it. Safe for the locker: lock-cmd.sh runs it in its
# own scope.
if [ -f "$HOME/.config/hypr-de/hypridle.conf" ]; then
    echo "→ hypridle (per-host knobs)"
    systemctl --user try-restart hypridle.service || true
fi
