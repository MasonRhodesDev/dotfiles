#!/bin/bash
set -euo pipefail

{{ if or .is_work (not (dig "headless" false .)) -}}
echo "t3code: not a headless agent host; skipping."
exit 0
{{ end -}}

T3_VERSION=0.1.9
T3="$HOME/.local/bin/t3"

if ! command -v systemctl >/dev/null || ! systemctl --user show-environment >/dev/null 2>&1; then
  echo "t3code: no systemd user manager here; skipping." >&2
  exit 0
fi

if [ ! -x "$T3" ]; then
  curl -fsSL https://t3.codes/install.sh | T3CODE_VERSION="$T3_VERSION" sh
elif [ "$("$T3" --version)" != "t3 v$T3_VERSION" ]; then
  "$T3" update "$T3_VERSION" --allow-downgrade --yes
fi

mkdir -p "$HOME/.config/systemd/user/t3code.service.d"
cat > "$HOME/.config/systemd/user/t3code.service.d/path.conf" <<'UNIT'
[Service]
Environment=PATH=%h/.local/bin:%h/.cargo/bin:/usr/local/bin:/usr/bin
UNIT

"$T3" up --lan --yes
