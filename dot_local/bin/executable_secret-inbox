#!/usr/bin/env python3
"""Phone-friendly form for typing a requested secret straight into Infisical.

`infisical-ask KEY "what it is"` registers a request here and gets back a link.
Opening that link (over `tailscale serve`, tailnet only, owner only) shows a
one-field form; submitting it writes the value to Infisical with the write-capable
identity in ~/.config/infisical/inbox.env. infisical-env-sync then delivers it to
shells. Values are held only for the duration of the request and never logged.
"""
import html
import json
import os
import re
import secrets
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import parse_qs

CONF_DIR = os.path.expanduser("~/.config/infisical")
TOKEN_FILE = os.path.join(CONF_DIR, "inbox.token")
REQUEST_TTL = 30 * 60
VALID_KEY = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")
DENY = {"PATH", "HOME", "USER", "SHELL", "BASH_ENV", "ENV", "IFS", "PS1", "PS2",
        "PROMPT_COMMAND", "LD_PRELOAD", "LD_LIBRARY_PATH", "PWD", "OLDPWD"}

requests_lock = threading.Lock()
pending = {}  # id -> {key, note, created, status}


def log(msg):
    print(msg, file=sys.stderr, flush=True)


def read_env(path):
    conf = {}
    with open(path) as f:
        for line in f:
            line = line.strip()
            if line and not line.startswith("#") and "=" in line:
                k, v = line.split("=", 1)
                conf[k.strip()] = v.strip().strip("'\"")
    return conf


def tailnet_self():
    d = json.loads(subprocess.run(["tailscale", "status", "--json"], check=True,
                                  capture_output=True, text=True).stdout)
    login = d["User"][str(d["Self"]["UserID"])]["LoginName"]
    return login, d["Self"]["DNSName"].rstrip(".")


def api(method, path, body, token=None):
    domain = os.environ.get("INFISICAL_API_URL", "https://app.infisical.com")
    req = urllib.request.Request(domain + path, method=method, data=json.dumps(body).encode(),
                                 headers={"Content-Type": "application/json"})
    if token:
        req.add_header("Authorization", "Bearer " + token)
    try:
        with urllib.request.urlopen(req, timeout=20) as r:
            return r.status, json.loads(r.read() or b"{}")
    except urllib.error.HTTPError as e:
        try:
            return e.code, json.loads(e.read() or b"{}")
        except ValueError:
            return e.code, {}


def write_secret(key, value):
    machine = read_env(os.path.join(CONF_DIR, "machine.env"))
    inbox = read_env(os.path.join(CONF_DIR, "inbox.env"))
    status, body = api("POST", "/api/v1/auth/universal-auth/login",
                       {"clientId": inbox["INBOX_CLIENT_ID"], "clientSecret": inbox["INBOX_CLIENT_SECRET"]})
    if status != 200:
        raise RuntimeError(f"inbox identity login failed: {body.get('message', status)}")
    token = body["accessToken"]
    payload = {"projectId": machine["INFISICAL_PROJECT_ID"],
               "environment": machine.get("INFISICAL_ENV", "dev"),
               "secretPath": machine.get("INFISICAL_PATH", "/"),
               "secretValue": value}
    status, body = api("POST", f"/api/v4/secrets/{key}", payload, token)
    if status == 400 and "exist" in str(body.get("message", "")).lower():
        status, body = api("PATCH", f"/api/v4/secrets/{key}", payload, token)
    if status != 200:
        raise RuntimeError(f"Infisical refused the write: {body.get('message', status)}")


PAGE = """<!doctype html><html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="referrer" content="no-referrer"><title>Secret inbox</title>
<style>
:root {{ --bg:#f6f6f4; --fg:#1b1b1a; --muted:#6b6b66; --card:#fff; --line:#d9d9d4; --accent:#2f5d50; --err:#a3322a; }}
@media (prefers-color-scheme: dark) {{ :root {{ --bg:#141413; --fg:#ecebe6; --muted:#9a9993; --card:#1e1e1c; --line:#33332f; --accent:#7fb8a4; --err:#e0857c; }} }}
* {{ box-sizing:border-box }}
body {{ margin:0; background:var(--bg); color:var(--fg); font:16px/1.45 system-ui, sans-serif; padding:24px 16px; }}
main {{ max-width:520px; margin:0 auto; background:var(--card); border:1px solid var(--line); border-radius:12px; padding:20px; }}
h1 {{ font-size:13px; font-weight:600; letter-spacing:.06em; text-transform:uppercase; color:var(--muted); margin:0 0 12px }}
code {{ font:600 20px ui-monospace, monospace; word-break:break-all }}
p {{ margin:8px 0 }} .muted {{ color:var(--muted); font-size:14px }} .err {{ color:var(--err) }}
textarea {{ width:100%; min-height:96px; margin:16px 0 12px; padding:12px; font:15px ui-monospace, monospace;
  background:var(--bg); color:var(--fg); border:1px solid var(--line); border-radius:8px; -webkit-text-security:disc; }}
textarea.show {{ -webkit-text-security:none }}
.row {{ display:flex; gap:12px; align-items:center; justify-content:space-between }}
button {{ font:600 16px system-ui; padding:12px 20px; border-radius:8px; border:0; background:var(--accent); color:var(--bg) }}
label {{ font-size:14px; color:var(--muted) }}
</style></head><body><main>{body}</main></body></html>"""


def page(body):
    return PAGE.format(body=body).encode()


class Handler(BaseHTTPRequestHandler):
    server_version = "secret-inbox"

    def log_message(self, fmt, *args):  # keep request lines out of the journal: paths carry request ids
        pass

    def send(self, code, body, ctype="text/html; charset=utf-8"):
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Frame-Options", "DENY")
        self.send_header("Content-Security-Policy", "default-src 'none'; style-src 'unsafe-inline'; script-src 'unsafe-inline'; form-action 'self'")
        self.end_headers()
        self.wfile.write(body)

    def json(self, code, obj):
        self.send(code, json.dumps(obj).encode(), "application/json")

    def body(self):
        n = int(self.headers.get("Content-Length") or 0)
        return self.rfile.read(min(n, 64 * 1024)).decode("utf-8", "replace")

    def local_api_ok(self):
        # Local CLI calls carry the token; requests proxied by tailscale serve carry user headers.
        return (not self.headers.get("Tailscale-User-Login")
                and secrets.compare_digest(self.headers.get("Authorization", ""), "Bearer " + self.server.api_token))

    def owner_ok(self):
        return self.headers.get("Tailscale-User-Login") == self.server.owner

    def lookup(self, rid):
        with requests_lock:
            r = pending.get(rid)
            if r and time.time() - r["created"] > REQUEST_TTL and r["status"] == "pending":
                r["status"] = "expired"
            return r

    # ── local API ──
    def do_api(self, method):
        if not self.local_api_ok():
            return self.json(403, {"error": "forbidden"})
        if method == "POST" and self.path == "/api/requests":
            try:
                data = json.loads(self.body() or "{}")
            except ValueError:
                return self.json(400, {"error": "bad json"})
            key, note = str(data.get("key", "")), str(data.get("note", ""))[:500]
            if not VALID_KEY.match(key) or key in DENY:
                return self.json(400, {"error": f"invalid or protected key: {key!r}"})
            rid = secrets.token_urlsafe(18)
            with requests_lock:
                pending[rid] = {"key": key, "note": note, "created": time.time(), "status": "pending"}
            log(f"request opened for {key}")
            return self.json(200, {"id": rid, "url": f"https://{self.server.dns}:{self.server.public_port}/r/{rid}"})
        m = re.fullmatch(r"/api/requests/([\w-]+)", self.path)
        if method == "GET" and m:
            r = self.lookup(m.group(1))
            return self.json(200 if r else 404, {"status": r["status"], "key": r["key"]} if r else {"error": "unknown"})
        return self.json(404, {"error": "not found"})

    # ── phone form ──
    def do_form(self, method, rid):
        if not self.owner_ok():
            return self.send(403, page("<h1>Secret inbox</h1><p class=err>Not allowed from this device.</p>"))
        r = self.lookup(rid)
        if not r:
            return self.send(404, page("<h1>Secret inbox</h1><p>This request doesn't exist (or the inbox restarted). Ask Claude for a new link.</p>"))
        key = html.escape(r["key"])
        if r["status"] != "pending":
            msg = {"done": f"<code>{key}</code> is saved. You can close this.",
                   "expired": "This request expired. Ask Claude for a new link."}.get(r["status"], r["status"])
            return self.send(200, page(f"<h1>Secret inbox</h1><p>{msg}</p>"))
        error = ""
        if method == "POST":
            value = parse_qs(self.body(), keep_blank_values=True).get("value", [""])[0]
            value = value.replace("\r\n", "\n").strip("\n")
            if not value:
                error = "<p class=err>Value is empty.</p>"
            else:
                try:
                    write_secret(r["key"], value)
                except Exception as e:
                    log(f"write failed for {r['key']}: {e}")
                    error = f"<p class=err>{html.escape(str(e))}</p>"
                else:
                    with requests_lock:
                        r["status"] = "done"
                    log(f"saved {r['key']}")
                    return self.send(200, page(f"<h1>Secret inbox</h1><p><code>{key}</code> saved to Infisical.</p>"
                                               "<p class=muted>It reaches your machines within about 10 seconds. You can close this.</p>"))
        note = f"<p>{html.escape(r['note'])}</p>" if r["note"] else ""
        body = (f"<h1>Secret inbox · {html.escape(self.server.host)}</h1><code>{key}</code>{note}{error}"
                f"<form method=post autocomplete=off><textarea id=v name=value autofocus spellcheck=false "
                f"autocapitalize=off autocorrect=off placeholder=\"Paste the value\"></textarea>"
                f"<div class=row><label><input type=checkbox onchange=\"v.classList.toggle('show',this.checked)\"> Show</label>"
                f"<button>Save to Infisical</button></div></form>"
                f"<p class=muted>Goes straight to Infisical ({html.escape(self.server.target)}). Nothing is written to disk.</p>")
        return self.send(200, page(body))

    def route(self, method):
        if self.path.startswith("/api/"):
            return self.do_api(method)
        m = re.fullmatch(r"/r/([\w-]+)", self.path)
        if m:
            return self.do_form(method, m.group(1))
        return self.send(404, page("<h1>Secret inbox</h1><p>Nothing here.</p>"))

    def do_GET(self):
        self.route("GET")

    def do_POST(self):
        self.route("POST")


def main():
    inbox = read_env(os.path.join(CONF_DIR, "inbox.env"))
    if not (inbox.get("INBOX_CLIENT_ID") and inbox.get("INBOX_CLIENT_SECRET")):
        log("not configured: fill in ~/.config/infisical/inbox.env, then restart secret-inbox")
        return
    port = int(os.environ.get("INBOX_PORT", "8470"))
    srv = ThreadingHTTPServer(("127.0.0.1", port), Handler)
    srv.public_port = int(os.environ.get("INBOX_PUBLIC_PORT", port))
    srv.owner, srv.dns = tailnet_self()
    srv.owner = os.environ.get("INBOX_ALLOWED_LOGIN", srv.owner)
    srv.host = srv.dns.split(".")[0]
    machine = read_env(os.path.join(CONF_DIR, "machine.env"))
    srv.target = f"{machine.get('INFISICAL_ENV', 'dev')} {machine.get('INFISICAL_PATH', '/')}"
    srv.api_token = secrets.token_urlsafe(32)
    fd = os.open(TOKEN_FILE + ".tmp", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(srv.api_token)
    os.replace(TOKEN_FILE + ".tmp", TOKEN_FILE)
    log(f"listening on 127.0.0.1:{port}, form at https://{srv.dns}:{srv.public_port}/r/…, owner {srv.owner}")
    srv.serve_forever()


if __name__ == "__main__":
    main()
