#!/bin/bash
# Managed by chezmoi — re-runs when any tracked service file changes.
# DE services (hypridle, swaync, waybar, swaybg, udiskie, …) are enabled by
# the hypr-de package's user preset + hypr-de-setup, not here.
#
# Service checksums (do not edit — used to detect changes):
# api-keys:              {{ include "dot_config/systemd/user/api-keys.service" | sha256sum }}
# browser-guard.path:    {{ include "dot_config/systemd/user/browser-default-guard.path" | sha256sum }}
# browser-guard.service: {{ include "dot_config/systemd/user/browser-default-guard.service" | sha256sum }}
# browser-guard.bin:     {{ include "dot_local/bin/executable_browser-default-guard" | sha256sum }}
# hypridle (mason-air):  {{ include "dot_config/hypr/hypridle.conf.tmpl" | sha256sum }}
# hypridle drop-in:      {{ include "dot_config/systemd/user/hypridle.service.d/zz-mason-air-conf.conf.tmpl" | sha256sum }}

set -euo pipefail

systemctl --user daemon-reload

echo "→ api-keys"
systemctl --user enable api-keys 2>/dev/null || true
systemctl --user restart api-keys || true

# Path-triggered guard that reasserts Chromium as the default browser whenever
# Slack hijacks mimeapps.list. Enable/start the .path (not the .service — the
# oneshot service is launched by the path unit on demand).
echo "→ browser-default-guard.path"
systemctl --user enable browser-default-guard.path 2>/dev/null || true
systemctl --user restart browser-default-guard.path || true

# mason-air only: hypridle runs a chezmoi-managed conf via a unit drop-in
# (shorter idle suspend). Restart it when either file changed. Restarting
# hypridle is safe for the locker: lock-cmd.sh runs it in its own scope.
if [ -f "$HOME/.config/systemd/user/hypridle.service.d/zz-mason-air-conf.conf" ]; then
    echo "→ hypridle (mason-air conf)"
    systemctl --user try-restart hypridle.service || true
fi
