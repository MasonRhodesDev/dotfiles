#!/usr/bin/env bash
set -euo pipefail
project=$HOME/.config/infisical/project.json
[ -r "$project" ] || { echo "infisical-exec: no Infisical project for this machine (private.infisical in its entry)" >&2; exit 3; }
INFISICAL_TOKEN=$(@login@)
export INFISICAL_TOKEN
exec infisical run --watch --silent --projectId="$(@jq@ -r .projectId "$project")" \
    --env="$(@jq@ -r .environment "$project")" --path="$(@jq@ -r .path "$project")" -- "$@"
