# Shared environment variables for bash and fish
# This file uses POSIX sh syntax for compatibility

# Editor configuration
export EDITOR="{{ .chezmoi.homeDir }}/scripts/nvim-open"
export VISUAL="{{ .chezmoi.homeDir }}/scripts/nvim-open"

# Environment variables
export WALLPAPER_PATH="{{ .chezmoi.homeDir }}/Pictures/forrest.png"

# ydotool socket
export YDOTOOL_SOCKET=/tmp/.ydotool_socket

# PATH additions
export PATH="{{ .chezmoi.homeDir }}/.local/bin:$PATH"
export PATH="{{ .chezmoi.homeDir }}/scripts:$PATH"
export PATH="{{ .chezmoi.homeDir }}/bin:$PATH"
export PATH="$PATH:/opt/nvim-linux-x86_64/bin"

# pnpm
export PNPM_HOME="{{ .chezmoi.homeDir }}/.local/share/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac

# TRANSITIONAL: this file exists only because fish cannot read ~/.bashrc.d.
# It is parsed by fish via conf.d/environment.fish, which merely greps `export`
# lines and expands $HOME/$PATH — shell conditionals and intermediate variables
# are NOT evaluated there, so every entry above must stay a literal one-liner.
# Once fish is retired this file can be deleted outright: every entry in it is
# already covered by a ~/.bashrc.d topic file (see 00-path-helpers.bashrc).
#
# fnm is deliberately absent — it is set by ~/.bashrc.d/node.bashrc for bash and
# ~/.config/fish/conf.d/fnm.fish for fish. Duplicating it here put a second copy
# in PATH for both shells.

# kimi-code (installer only wires up fish; keep it here so bash gets it too).
# APPENDED, not prepended: this dir also ships its own `fd`, which would
# otherwise shadow /usr/bin/fd system-wide.
export PATH="$PATH:{{ .chezmoi.homeDir }}/.kimi-code/bin"
