{{- if eq .system.hostname "mason-air" -}}
# mason-air override of /usr/share/hypr-de/hypr/hypridle.conf (chezmoi-managed,
# wired in by ~/.config/systemd/user/hypridle.service.d/zz-mason-air-conf.conf).
# Identical to the package file except the idle-suspend request: 300 s instead
# of 900 s. This machine is an SSH client whose sessions live in remote tmux,
# so there is nothing local worth keeping awake. Re-sync by hand when the
# package file changes; the durable fix is a per-host knob in hypr-DE.
#
# hypr-DE idle policy. Dispatch args are Lua expressions because hypr-DE runs the
# Lua config dialect exclusively (classic `dpms on/off` fails there).
#
# Idle suspend is a REQUEST, not a command: the suspend listener below asks
# hyprstate (`hyprstate suspend request`) and hyprstate owns everything after
# which means the 30 s grace countdown, proof of a live locker, cancellation, and the
# logind Suspend() call. The same single path the lid uses; a systemctl
# suspend here would be a second writer racing that machinery.
general {
  after_sleep_cmd=hyprctl dispatch "hl.dsp.dpms({ action = 'on' })"
  # vigil-lock --wait exits only once the compositor confirms the
  # session lock, and hypridle holds its logind sleep inhibitor until
  # before_sleep_cmd returns, so a suspend can never outrun the lock
  # (previously there was no before_sleep_cmd at all: lid-close before
  # the idle timeout suspended unlocked).
  lock_cmd=/usr/lib/hypr-de/lock-cmd.sh
  before_sleep_cmd=/usr/lib/hypr-de/lock-cmd.sh --sleep
  # Belt AND suspenders with --wait: hypridle releases its sleep
  # inhibitor on command *spawn*, not completion, so mode 3 makes it wait
  # for the compositor's lock-notify event before letting the suspend
  # proceed. (Costs on_lock_cmd/on_unlock_cmd, which we don't use.)
  inhibit_sleep=3
}

listener {
  # Idle is the only cancelable path. Manual loginctl locks and suspend keep
  # using general.lock_cmd / before_sleep_cmd and therefore lock immediately.
  #
  # The warn/blur IS ladder entry (decided model), so a live keep-awake
  # claim must stop it here. Two belts: hypridle's own inhibitor ledger
  # (ignore_inhibit stays false - covers ScreenSaver D-Bus claims like a
  # browser video), and the STATELESS no-keep-awake.sh condition, which
  # re-derives Wayland client claims, the toggle, logind idle-blocks, and
  # a running game at fire time. The second exists because the first is
  # wiped by any hypridle restart - a package upgrade mid-game silently
  # dropped Steam's overlay claim and blurred over a live game. The 10 s
  # retry doubles as decision 2's clock: a claim releasing after a long
  # absence warns and locks within ~10 s.
  timeout=180 # 3 minutes
  condition_cmd=/usr/lib/hypr-de/no-keep-awake.sh
  condition_retry=10
  on-timeout=/usr/lib/hypr-de/lock-cmd.sh --idle
}

listener {
  # The session's only DPMS-off, and it fires only while the compositor
  # holds the lock.
  #
  # An unlocked session is never blanked: a dark screen over a live desktop
  # is indistinguishable from a locked one. The 240 s unlocked blanker this
  # replaces could reach exactly that state, namely a lock cancelled without
  # input (an output hotplug cancels vigil's warning surface) or a warning
  # that outlived it left the desktop live at 240 s, and hyprstate >= 2.5.0
  # relit it on the next reconcile tick anyway, so all it produced was a
  # flash. An idle session locks at 180 s; if that lock does not take, the
  # screen stays honestly lit.
  #
  # hyprstate no longer blanks either (its timer had no input signal and
  # re-blanked under the user's hands, hyprstate#24), so this is the single
  # writer.
  #
  # A locked screen ALWAYS blanks (decided model, 2026-09-04): keep-awake
  # claims, meaning the user's toggle and app inhibitors alike, indistinguishable
  # by design, govern only the unlocked machine, where they prevent the
  # idle lock. Once locked, nothing keeps the screen lit: ignore_inhibit
  # drops hypridle's whole inhibitor accounting and session-locked.sh
  # checks exactly one thing, the compositor lock. (The former toggle
  # re-admission is gone with the model.)
  #
  # condition_cmd gates on the compositor lock, and condition_retry blanks
  # a session that went idle first and locked later (hypridle >= 0.1.8;
  # while unlocked and idle it costs one `hyprctl locked` per retry). Any
  # input cancels a pending retry and restarts the 30 s.
  #
  # Unlock without input (loginctl unlock-session over SSH) leaves the
  # outputs dark until hyprstate's stuck-DPMS repair relights them within
  # one reconcile tick. Known gap: resume from suspend without input never
  # re-arms this listener (hypr-DE#29).
  timeout=30
  ignore_inhibit=true
  condition_cmd=/usr/lib/hypr-de/session-locked.sh
  condition_retry=10
  on-timeout=/usr/lib/hypr-de/dpms-off-if-locked.sh
  on-resume=hyprctl dispatch "hl.dsp.dpms({ action = 'on' })"
}

listener {
  # Idle suspend. Requests only: hyprstate runs its usual countdown (30 s
  # grace), proves a live locker, and only then calls logind Suspend(), which is
  # the identical path a lid close takes. Cancellation is belt and
  # suspenders: on-resume withdraws the request on first input, and
  # hyprstate re-checks the request file at grace expiry regardless.
  #
  # ignore_inhibit + gated on the compositor lock (decided model,
  # 2026-09-04): lock ends every keep-awake claim's authority, so 900 s of
  # true input idle suspends a LOCKED machine unconditionally, the same
  # shape as the blanker above. The gate is the lock itself: a machine a
  # claim kept unlocked (HELD_AWAKE) never fires this, because claims
  # govern exactly the unlocked machine. condition_retry covers a session
  # that went idle first and locked later.
  timeout=300 # 5 minutes of true input idle (mason-air; package default 900); suspend lands ~30 s later
  ignore_inhibit=true
  condition_cmd=/usr/lib/hypr-de/session-locked.sh
  condition_retry=10
  on-timeout=/usr/lib/hypr-de/idle-suspend.sh
  on-resume=/usr/lib/hypr-de/idle-suspend.sh --cancel
}
{{- end -}}
