#!/bin/bash

if ! command -v gitleaks >/dev/null 2>&1; then
    echo "pre-commit: gitleaks is not installed, so the secret scan was skipped." >&2
    exit 0
fi

repo_root="$(git rev-parse --show-toplevel)"
if ! gitleaks git --staged --no-banner --redact --config "$repo_root/.gitleaks.toml" >/dev/null 2>&1; then
    echo "" >&2
    echo "pre-commit: gitleaks found potential secrets in staged changes:" >&2
    gitleaks git --staged --no-banner --redact --config "$repo_root/.gitleaks.toml" 2>&1 | tail -20 >&2
    echo "" >&2
    echo "This repo is public. Remove the secret, or if it is a false positive add an allowlist entry to .gitleaks.toml." >&2
    exit 1
fi

guard="${XDG_DATA_HOME:-$HOME/.local/share}/dotfiles-work/secret-guard.txt"
if [ -f "$guard" ]; then
    staged="$(git diff --cached --no-color)"
    while IFS= read -r pat; do
        [ -z "$pat" ] && continue
        case "$pat" in \#*) continue ;; esac
        if printf '%s' "$staged" | grep -iqF -- "$pat"; then
            echo "" >&2
            echo "pre-commit: staged changes contain a term from the blocklist in $guard." >&2
            echo "This repo is public. Real values belong in the private repo." >&2
            exit 1
        fi
    done < "$guard"
fi
exit 0
