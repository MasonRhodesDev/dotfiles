-- hypr-DE user overrides (chezmoi-managed, per-machine). Runs after
-- /usr/share/hypr-de/hypr/main.lua — last-wins. Monitor layouts stay in
-- ~/.config/hypr/profiles/ (see local.lua.example in the package).

{{/* mason-air: M1 MacBook Air on Asahi (aarch64). One internal panel, an
     Apple keyboard, and no Steam on ARM — so the Framework-16 key map, the
     eDP-2 workspace pin and the whole gaming layer are all wrong there.
     Monitor layout is deliberately NOT here: hyprstate owns
     ~/.config/hypr/profiles/, which chezmoi does not track. */}}
{{- $air := eq .system.hostname "mason-air" -}}

-- Personal window rules that don't belong in the distributable DE
hl.window_rule({ name = "keep-tile",        match = { title = "^(keep.google.com_/)$" }, tile = true })
hl.window_rule({ name = "crx-float",        match = { title = "^(_crx_nngceckbapebfimnlniiiahkandclblb)$" }, float = true })
hl.window_rule({ name = "hyprdm",           match = { class = "^(hyprdm)$" }, float = true, center = true, size = "600 460" })
hl.window_rule({ name = "android-emulator", match = { class = "^(Emulator)$" }, float = true })
{{ if not $air }}hl.workspace_rule({ workspace = "9", monitor = "eDP-2" }){{ end }}
hl.window_rule({ name = "vigil-simulator", match = { title = "^(Vigil Simulation.*)$" }, workspace = "9 silent", float = true, center = true, size = "1280 800", no_initial_focus = true })

-- Scratchpad routing + voice dictation (moved out of the hypr-de package)
hl.window_rule({ name = "discord-special",  match = { class = "^(discord)$" }, workspace = "special:magic silent" })
hl.window_rule({ name = "slack-special",    match = { class = "^(slack)$" }, workspace = "special:magic silent" })
hl.window_rule({ name = "ytmusic-special",  match = { title = "^(YouTube Music)$" }, workspace = "special:magic silent" })
hl.window_rule({ name = "voice-dictation",  match = { class = "^(dev.mason.dictation)$" }, float = true, pin = true, size = "200 50", move = "50%-100 95%", border_size = 0, no_blur = true, no_shadow = true, no_initial_focus = true, no_focus = true })
hl.window_rule({ name = "zoom-annotate",    match = { class = "^(zoom)$", title = "^(annotate_toolbar)$" }, float = true, size = "1 1", move = "-9999 -9999", opacity = "0.0 override 0.0 override", border_size = 0, no_blur = true, no_shadow = true, no_initial_focus = true, no_focus = true })

-- FW16 F13-24 keys + caps-as-shift (moved out of the hypr-de package)
{{ if $air -}}
-- Apple internal keyboard: no F13-24 row, and Asahi already maps Cmd to
-- Super. Keep caps-as-shift, drop the Framework fkeys map.
hl.config({ input = { kb_options = "caps:shift" } })

-- Apple fn row (hid_apple fnmode=1, see .chezmoiscripts/58-asahi-fnkeys.sh):
-- F1/F2 brightness, F7..F12 media and volume already land on the XF86 binds
-- in main.lua. The four macOS-only legends get their nearest equivalent here.
-- These are ADDITIONS: the SUPER chords from main.lua stay for an external
-- keyboard, the fn row is just the primary way in on this machine.
hl.bind("XF86LaunchA",      hl.dsp.exec_cmd("/usr/bin/hypr-de-snip"), { desc = "Screenshots: Region screenshot + annotate (F3 Mission Control)" })
hl.bind("SHIFT + XF86LaunchA", hl.dsp.exec_cmd("/usr/bin/hypr-de-record"), { desc = "Screenshots: Screen recording (Shift+F3)" })
hl.bind("XF86Search",       hl.dsp.exec_cmd("pkill fuzzel || uwsm app -- fuzzel --config /usr/share/hypr-de/fuzzel/fuzzel.ini"), { desc = "Apps: App launcher (F4 Spotlight)" })
-- Push to talk: hold the mic key to record, release to transcribe and type.
hl.bind("XF86AudioMicMute", hl.dsp.exec_cmd("voice-dictation start"), { desc = "System: Voice dictation push to talk, hold (F5 mic)" })
hl.bind("XF86AudioMicMute", hl.dsp.exec_cmd("voice-dictation confirm"), { release = true, desc = "System: Voice dictation push to talk, release (F5 mic)" })
hl.bind("XF86Sleep",        hl.dsp.exec_cmd("swaync-client -d -sw"), { locked = true, desc = "System: Do Not Disturb (F6 moon)" })
-- Keyboard backlight (/sys/class/leds/kbd_backlight, 0..255). The M1 Air has
-- no dedicated keys for it (macOS puts it in Control Center), so SUPER + the
-- screen brightness keys drive it: Cmd+F1 down, Cmd+F2 up. Boots at 0.
hl.bind("SUPER + XF86MonBrightnessDown", hl.dsp.exec_cmd("brightnessctl -q -d kbd_backlight set 10%- && notify-send -t 1500 -a osd-brightness -h string:x-canonical-private-synchronous:kbd -h int:value:$(brightnessctl -d kbd_backlight -m | cut -d, -f4 | tr -d %) 'Keyboard' ''"), { locked = true, repeating = true, desc = "Media: Keyboard backlight down (Cmd+F1)" })
hl.bind("SUPER + XF86MonBrightnessUp",   hl.dsp.exec_cmd("brightnessctl -q -d kbd_backlight set +10% && notify-send -t 1500 -a osd-brightness -h string:x-canonical-private-synchronous:kbd -h int:value:$(brightnessctl -d kbd_backlight -m | cut -d, -f4 | tr -d %) 'Keyboard' ''"), { locked = true, repeating = true, desc = "Media: Keyboard backlight up (Cmd+F2)" })
{{- else -}}
hl.config({ input = { kb_options = "fkeys:basic_13-24,caps:shift" } })
{{- end }}

-- Personal keybinds
hl.bind("CTRL + ALT + SHIFT + v", hl.dsp.exec_cmd("voice-dictation toggle"), { desc = "System: Voice dictation" })
-- Audio output switcher (wofi list; SHIFT+XF86AudioPlay in main.lua opens hyprpwcenter)
hl.bind("SUPER + XF86AudioPlay", hl.dsp.exec_cmd(os.getenv("HOME") .. "/.config/wofi/change-default-audio-device.js WofiListAudioDevices"))
-- hypruse panic: kill computer-use MCP if it takes the seat
hl.bind("SUPER + SHIFT + BackSpace", hl.dsp.exec_cmd(os.getenv("HOME") .. "/.local/bin/hypruse stop"))

-- Wake DPMS on input so a VT return with outputs disabled can modeset
-- (Aquamarine will not schedule frames while enabledState is false).
hl.config({
    misc = {
        mouse_move_enables_dpms = true,
        key_press_enables_dpms = true,
    },
})

-- Swap main.lua's workspace-to-monitor directions: minus = next, equal = previous
-- (hl.bind appends rather than replaces, so drop the package binds first)
hl.unbind("SUPER + SHIFT + minus")
hl.unbind("SUPER + SHIFT + equal")
hl.bind("SUPER + SHIFT + minus", hl.dsp.workspace.move({ monitor = "+1" }), { desc = "Workspaces: Move workspace to next monitor" })
hl.bind("SUPER + SHIFT + equal", hl.dsp.workspace.move({ monitor = "-1" }), { desc = "Workspaces: Move workspace to previous monitor" })

{{ if and (not .is_work) (not $air) -}}
-- Gaming layer (hypr-de-gaming package)
dofile("/usr/share/hypr-de/gaming/game-rules.lua")

-- Keep games rendering at a steady 60fps when their workspace is hidden —
-- Elden Ring's online watchdog kicks the session if fps collapses while
-- tabbed away (hidden workspaces otherwise get no frame callbacks at all).
hl.config({ misc = { render_unfocused_fps = 60 } })
hl.window_rule({ name = "games-render-unfocused", match = { class = "^(steam_app_\\d+)$" }, render_unfocused = true })

-- Sharp XWayland on fractionally scaled monitors (dual-4k/laptop profiles):
-- render at native pixels instead of compositor upscaling. Steam UI can
-- compensate via -forcedesktopscaling / its UI scale slider if needed.
hl.config({ xwayland = { force_zero_scaling = true } })

-- Swiftpoint Z3: "pick up + roll right" gesture sends F20 (Control Panel
-- Global mapping "Show Profile OSD") -> show active mouse profile on screen
hl.bind("F20", hl.dsp.exec_cmd(os.getenv("HOME") .. "/.local/bin/swiftpoint-profile-osd"), { desc = "Mouse: Show Swiftpoint profile" })
{{ end -}}

-- Autostart
hl.on("hyprland.start", function()
{{ if .is_work }}
    -- Slack starts from ~/.config/autostart/slack.desktop instead: that path is
    -- systemd-ordered after sni-watcher, exec-once is not (tray icon race, 2026-09-29).
{{ end }}
{{/* Neither Steam nor Discord has an aarch64 build; on mason-air these
     only produced "Command not found" toasts at every login. */}}
{{ if and (not .is_work) (not $air) }}
    hl.exec_cmd(os.getenv("HOME") .. "/.local/bin/steam-launch")
    hl.exec_cmd("uwsm app -- discord")
{{ end }}
end)

-- Steam Big Picture modules, each a no-op when its file is absent so machines
-- that do not deploy them are unaffected. Order matters: bp-focus exports
-- BP_FOCUS.streaming, which bp-monitors reads.
--   bp-focus.lua    game priority while streaming or in Big Picture, special
--                   workspaces only on user action
--   bp-monitors.lua one monitor while Big Picture runs, the 16:9 panel while
--                   a stream is live
do
    local base = os.getenv("XDG_CONFIG_HOME")
    if not base or base == "" then base = os.getenv("HOME") .. "/.config" end
    for _, name in ipairs({ "bp-focus", "bp-monitors" }) do
        local ok, err = pcall(dofile, base .. "/hypr/" .. name .. ".lua")
        if not ok and not tostring(err):find("No such file", 1, true) then
            hl.exec_cmd("logger -t hypr-local -- " .. ("'%s: %s'"):format(name, tostring(err):gsub("'", "")))
        end
    end
end
