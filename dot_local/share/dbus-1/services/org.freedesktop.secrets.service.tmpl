[D-BUS Service]
Name=org.freedesktop.secrets
Exec=/usr/bin/gnome-keyring-daemon --start --foreground --components=secrets
{{- /* Route D-Bus activation of the secret service through the systemd user
       unit (gnome-keyring >= 46). Without this, dbus-broker spawns a transient
       `gnome-keyring-daemon --start` whenever the unit is down and the two
       daemons split-brain (2026-10-13). Only valid where the unit exists. */}}
{{- if stat "/usr/lib/systemd/user/gnome-keyring-daemon.service" }}
SystemdService=gnome-keyring-daemon.service
{{- end }}
