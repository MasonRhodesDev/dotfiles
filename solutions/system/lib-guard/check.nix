{ pkgs, evalHome, root }:
let
  built = (evalHome {
    modules = [
      ({ pkgs, ... }@args: { dotfiles.root.lib-guard = root args; })
      {
        dotfiles.root.vendor.repositories.arch.thirdparty = {
          url = "https://repo.example.invalid/$arch";
          key = { url = "https://keys.example.invalid/key.asc"; fingerprint = "8121421220927ACADF33B6D76639606D316BA178"; };
        };
      }
    ];
  }).config.dotfiles.root.lib-guard;
  hooks = builtins.attrNames built.files;
  hook = pkgs.writeText "dotfiles-lib-guard.hook" built.files."/etc/pacman.d/hooks/00-dotfiles-lib-guard.hook".text;
in
pkgs.runCommandCC "check-lib-guard" { nativeBuildInputs = [ pkgs.libarchive pkgs.binutils-unwrapped ]; } ''
  export FX=$TMPDIR/fx
  sys=$FX/sys
  mkdir -p $FX/bin $FX/build $FX/cache $sys/usr/lib $sys/opt/f/other $sys/opt/f/private $FX/new/usr/lib
  failures=0
  fail() { echo "FAIL $1"; echo "$2"; failures=$((failures + 1)); }
  has() { grep -qF -- "$3" <<< "$2" || fail "$1: no '$3' in" "$2"; }

  echo 'int f(void) { return 0; }' > $FX/build/empty.c
  library() {
    local out=$1 soname=$2
    shift 2
    cc -shared -fPIC ''${soname:+-Wl,-soname,$soname} -o "$out" $FX/build/empty.c -L$FX/build -Wl,--no-as-needed "$@"
  }
  for name in libold.so.1 libold2.so.1 libnew2.so.2 libgone.so.3 libmissing.so.7 libself.so.1; do library $FX/build/$name $name; done
  library $sys/opt/f/private/libpriv.so.1 libpriv.so.1
  library $sys/opt/f/libuser.so "" -l:libold.so.1
  library $sys/opt/f/libgoneuser.so "" -l:libgone.so.3
  library $sys/opt/f/private/libprivuser.so "" -L$sys/opt/f/private -l:libpriv.so.1 -Wl,-rpath,'$ORIGIN'
  library $sys/opt/f/other/libmissing.so.7 libmissing.so.7
  library $sys/opt/f/libmisc.so "" -l:libmissing.so.7
  library $sys/opt/f/libselfuser.so "" -l:libself.so.1
  library $sys/usr/lib/librepo.so "" -l:libold.so.1 -l:libgone.so.3
  library $sys/usr/lib/libthird.so "" -l:libold2.so.1
  library $FX/new/usr/lib/libthird.so "" -l:libnew2.so.2
  echo "not an ELF file" > $sys/opt/f/README
  rm $FX/build/lib*
  readelf -d $sys/opt/f/libuser.so | grep -q 'NEEDED.*libold.so.1' || fail "the fixture library needs libold.so.1" "$(readelf -d $sys/opt/f/libuser.so)"

  printf '%s\n' fpkg rpkg tpkg oldlib > $FX/installed
  echo fpkg > $FX/foreign
  echo "thirdparty tpkg 2-1 [installed: 1-1]" > $FX/sync-thirdparty
  echo "thirdparty notinstalled 1-1" >> $FX/sync-thirdparty
  { find $sys/opt/f -type d -printf '%p/\n'; find $sys/opt/f -type f; echo /usr/lib/libself.so.1; } > $FX/files-fpkg
  echo $sys/usr/lib/librepo.so > $FX/files-rpkg
  echo $sys/usr/lib/libthird.so > $FX/files-tpkg
  printf '%s\n' /usr/lib/libold.so.1 /usr/lib/libold.so.1.0.0 > $FX/files-oldlib
  mkdir -p $FX/newpkg
  cp -r $FX/new/usr $FX/newpkg/
  echo "pkgname = tpkg" > $FX/newpkg/.PKGINFO
  bsdtar --zstd -cf $FX/cache/tpkg-2-1-x86_64.pkg.tar.zst -C $FX/newpkg .PKGINFO usr
  mkdir -p $FX/stillpkg/usr/lib
  cp $sys/usr/lib/libthird.so $FX/stillpkg/usr/lib/
  bsdtar --zstd -cf $FX/cache/tpkg-still-x86_64.pkg.tar.zst -C $FX/stillpkg usr

  cat > $FX/ldcache <<'EOF'
  5 libs found in cache `/etc/ld.so.cache'
  	libold.so.1 (libc6,x86-64) => /usr/lib/libold.so.1
  	libold.so.1 (libc6) => /usr/lib32/libold.so.1
  	libold2.so.1 (libc6,x86-64) => /usr/lib/libold2.so.1
  	libnew2.so.2 (libc6,x86-64) => /usr/lib/libnew2.so.2
  	libself.so.1 (libc6,x86-64) => /usr/lib/libself.so.1
  Cache generated by: ldconfig (GNU libc) stable release version 2.42
  EOF

  cat > $FX/bin/pacman <<'EOF'
  #!/bin/sh
  echo "pacman $*" >> "$FX/calls"
  [ ! -e "$FX/broken" ] || exit 1
  case $1 in
    -Qq) cat "$FX/installed" ;;
    -Qmq) cat "$FX/foreign" ;;
    -Sl) cat "$FX/sync-$2" 2>/dev/null || { echo "error: repository '$2' was not found" >&2; exit 1; } ;;
    -Ql) shift; for p; do sed "s|^|$p |" "$FX/files-$p"; done ;;
    -Qqo) for p in oldlib; do grep -qxF -- "$2" "$FX/files-$p" && echo "$p"; done; true ;;
    -Sddp) [ -e "$FX/archive-$4" ] && cat "$FX/archive-$4" || { echo "error: target not found: $4" >&2; exit 1; } ;;
    *) exit 2 ;;
  esac
  EOF
  printf '#!/bin/sh\necho "%s"\n' "$FX/cache" > $FX/bin/pacman-conf
  printf '#!/bin/sh\n[ "$1" = -p ] && cat "$FX/ldcache"\n' > $FX/bin/ldconfig
  chmod +x $FX/bin/*
  export PATH=$FX/bin:$PATH

  [ "$(printf '%s\n' ${toString hooks} /usr/share/libalpm/hooks/10-glibc-remove-locale-archive.hook /usr/share/libalpm/hooks/60-mkinitcpio-remove.hook /usr/share/libalpm/hooks/gdk-pixbuf-remove-loaders-cache.hook | sed 's|.*/||' | LC_ALL=C sort | head -n 1)" = 00-dotfiles-lib-guard.hook ] \
    || fail "the hook runs before every other PreTransaction hook, so an abort comes before any of them has removed anything" "${toString hooks}"
  grep -q '^Exec = /bin/sh -c ' ${hook} || fail "the hook runs the guard through a shell that can say it is gone" "$(cat ${hook})"
  exec_line=$(sed -n "s/^Exec = \/bin\/sh -c '\(.*\)'$/\1/p" ${hook})
  guard=$(grep -o '/nix/store/[^/]*/bin/dotfiles-lib-guard' <<< "$exec_line" | head -n 1)
  [ -x "$guard" ] || fail "the hook names the guard program" "$exec_line"
  for line in "When = PreTransaction" "AbortOnFail" "NeedsTargets" "Type = Path" "Operation = Remove" "Target = usr/lib/*.so*" "Target = usr/lib32/*.so*"; do
    grep -qxF -- "$line" ${hook} || fail "the hook has '$line'" "$(cat ${hook})"
  done
  [ "$(awk -v RS= '/Type = Path/' ${hook} | grep -c '^Operation')" = 1 ] \
    || fail "the path trigger fires only for paths no package has after the transaction" "$(cat ${hook})"

  run() { printf '%s\n' "$@" | ${pkgs.runtimeShell} -c "$exec_line" 2>&1; }

  : > $FX/calls
  if result=$(run usr/lib/libold.so.1 usr/lib/libold.so.1.0.0 oldlib); then fail "a dropped library a foreign package loads stops the transaction" "$result"; fi
  has "the message names the library, the package that drops it, and the package that loads it" "$result" "libold.so.1 (from oldlib) is loaded by fpkg (foreign): $sys/opt/f/libuser.so"
  has "the message names what to rebuild" "$result" "rebuild these against the new libraries, or upgrade them in the same transaction: fpkg"
  has "the message says how to go ahead anyway" "$result" "sudo DOTFILES_LIB_GUARD=off pacman"
  case $result in *rpkg*) fail "a package from the distro repositories is not named" "$result" ;; esac

  result=$(printf '%s\n' usr/lib/libold.so.1 | DOTFILES_LIB_GUARD=off ${pkgs.runtimeShell} -c "$exec_line" 2>&1) \
    || fail "DOTFILES_LIB_GUARD=off lets the transaction go ahead" "$result"
  has "the override still names what to rebuild" "$result" "Rebuild these afterwards: fpkg"

  result=$(run usr/lib/libunused.so.4 usr/lib/libgone.so.3) || fail "a dropped library only distro packages load passes" "$result"
  [ -z "$result" ] || fail "a transaction that drops nothing a foreign package loads says nothing" "$result"

  result=$(run usr/lib32/libold.so.1) || fail "dropping the 32-bit copy of a library that a 64-bit foreign package loads passes" "$result"

  if result=$(run usr/lib/libold2.so.1); then fail "a dropped library that a package from a repository a solution adds loads stops the transaction" "$result"; fi
  has "a package from a solution's repository is named with that repository" "$result" "is loaded by tpkg (thirdparty)"

  echo "file://$FX/cache/tpkg-2-1-x86_64.pkg.tar.zst" > $FX/archive-tpkg
  result=$(run usr/lib/libold2.so.1 tpkg) || fail "a protected package upgraded in the same transaction to a build that no longer loads the library passes" "$result"
  echo "https://mirror.example.invalid/thirdparty/tpkg-2-1-x86_64.pkg.tar.zst" > $FX/archive-tpkg
  result=$(run usr/lib/libold2.so.1 tpkg) || fail "the new package is found in the cache by its file name" "$result"
  echo "file://$FX/cache/tpkg-still-x86_64.pkg.tar.zst" > $FX/archive-tpkg
  if result=$(run usr/lib/libold2.so.1 tpkg); then fail "a protected package upgraded to a build that still loads the library stops the transaction" "$result"; fi
  rm $FX/archive-tpkg
  if result=$(run usr/lib/libold2.so.1 tpkg); then fail "a protected package upgraded to a package that cannot be read stops the transaction" "$result"; fi

  result=$(run usr/lib/libself.so.1 fpkg) || fail "a foreign package upgraded to a build without a library it ships itself passes" "$result"
  result=$(run usr/lib/libself.so.1) || fail "removing a foreign package does not stop on the libraries it ships itself" "$result"

  : > $FX/calls
  result=$(run oldlib tpkg) || fail "a transaction that takes away no library passes" "$result"
  if grep -q -- '-Ql' $FX/calls; then fail "a transaction that takes away no library reads no file list" "$(cat $FX/calls)"; fi

  touch $FX/broken
  result=$(run usr/lib/libold.so.1) || fail "a check that cannot run does not hold the transaction back" "$result"
  has "a check that cannot run says so" "$result" "the check itself failed"
  rm $FX/broken

  gone=$(sed "s|$guard|/nix/store/00000000000000000000000000000000-gone/bin/dotfiles-lib-guard|" <<< "$exec_line")
  result=$(printf '%s\n' usr/lib/libold.so.1 | ${pkgs.runtimeShell} -c "$gone" 2>&1) || fail "a hook whose guard is gone does not hold the transaction back" "$result"
  has "a hook whose guard is gone says so" "$result" "is gone, so no library check ran"

  scan=$("$guard" unresolved 2>&1) || fail "the scan exits 0" "$scan"
  [ "$scan" = "fpkg (foreign) cannot load libgone.so.3: $sys/opt/f/libgoneuser.so need it. Rebuild fpkg." ] \
    || fail "the scan names only the foreign library that nothing provides, not one found in the cache, by \$ORIGIN, or shipped by the same package, nor one a distro package needs" "$scan"
  rm $sys/opt/f/other/libmissing.so.7
  sed -i "\|other/libmissing.so.7|d" $FX/files-fpkg
  scan=$("$guard" unresolved 2>&1) || fail "the scan exits 0 with two missing libraries" "$scan"
  has "a library the package no longer ships is named" "$scan" "fpkg (foreign) cannot load libmissing.so.7"
  : > $FX/foreign
  scan=$("$guard" unresolved 2>&1) || fail "the scan with no protected package exits 0" "$scan"
  case $scan in *fpkg*) fail "a package from the distro repositories is not scanned" "$scan" ;; esac

  [ "$failures" = 0 ]
  touch $out
''
