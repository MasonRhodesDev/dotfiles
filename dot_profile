PATH="$HOME/.local/bin:$PATH"
export npm_config_prefix="$HOME/.npm-global"
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

# Machine-local secrets for machines without a keyring (headless boxes): a
# 0600 KEY=value file, never tracked. The same file can be given to systemd
# user units with EnvironmentFile=.
if [ -r "$HOME/.config/secrets.env" ]; then
    set -a
    . "$HOME/.config/secrets.env"
    set +a
fi

# Session env vars (GNOME Keyring bucket: service=session-env). Loaded here
# so any sh/bash/zsh login shell (SSH, TTY, ...) gets them. Fish is covered
# separately by ~/.config/fish/conf.d/api-keys.fish.
if command -v list-session-env >/dev/null 2>&1; then
    eval "$(list-session-env | sed 's/^/export /')"
fi
